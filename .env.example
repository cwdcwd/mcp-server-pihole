# Pi-hole MCP Server Configuration
# Copy this file to .env and update with your Pi-hole details
# Existing service keys below are unchanged. The opt-in sidecar uses separate
# PIHOLE_MCP_TS_* names so it can be configured without touching current values.
# Its container port 3002 avoids the current Compose service's 3000 mapping.

# Your Pi-hole URL (required)
PIHOLE_BASE_URL=http://pihole.local

# Your Pi-hole admin password (required for most API endpoints)
PIHOLE_PASSWORD=your_pihole_admin_password_here

# Optional remote MCP transport (stdio remains the default)
# Set to http to serve authenticated Streamable HTTP at /mcp
PIHOLE_MCP_TRANSPORT=stdio
# Required when PIHOLE_MCP_TRANSPORT=http; use a long random bearer token
MCP_TOKEN=
# HTTP listener defaults to loopback for safety; set an explicit LAN host only when needed
PIHOLE_MCP_HTTP_HOST=127.0.0.1
PIHOLE_MCP_HTTP_PORT=3000
# Comma-separated hostnames and origins clients may use; default allows local loopback only
PIHOLE_MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
PIHOLE_MCP_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://[::1]:3000

# Optional side-by-side TypeScript HTTP overlay (docker-compose.sidecar.yml).
# Set real secret values only in a local ignored .env or a secret manager.
# Plain `docker compose up` never reads the overlay; the PIHOLE_MCP_TS_*
# checks fail fast only when the overlay is explicitly activated.
# PIHOLE_MCP_TS_BASE_URL=http://pihole.local
# PIHOLE_MCP_TS_PASSWORD=
# PIHOLE_MCP_TS_MCP_TOKEN=
# PIHOLE_MCP_TS_HTTP_PORT=3002
# PIHOLE_MCP_TS_PUBLISH_ADDRESS=127.0.0.1
# The container healthcheck probes itself claiming the first
# PIHOLE_MCP_TS_ALLOWED_HOSTS entry as its Host header.
# PIHOLE_MCP_TS_ALLOWED_HOSTS=pihole-mcp-candidate.local,localhost
# PIHOLE_MCP_TS_ALLOWED_ORIGINS=https://pihole-mcp-candidate.local
